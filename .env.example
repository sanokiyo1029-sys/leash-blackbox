# Copy to .env and fill in locally. Never commit .env.
# All variables are optional for local development.

# JSON-RPC endpoint of the independent chain (default: local Hardhat node)
LEASH_RPC_URL=http://127.0.0.1:8545

# Anchor service signing key. Leave empty to use the local node's managed account.
# Required for any non-development chain. Never commit a real key.
LEASH_ANCHOR_PRIVATE_KEY=

# Where the SQLite stores live (default: ./data)
LEASH_DATA_DIR=

# Maximum events per anchored batch (default: 256)
LEASH_MAX_BATCH_SIZE=

# Bearer token host agents must send to POST /api/events/ingest. Empty = open in demo mode only.
LEASH_INGEST_TOKEN=

# Lab endpoints (reset / synthetic traffic / attack simulation). 1 = enabled (default), 0 = refused (403)
LEASH_DEMO_MODE=1

# Comma-separated origins allowed to call the API (default: localhost:3000)
LEASH_CORS_ORIGINS=

# Frontend: base URL of the backend API
NEXT_PUBLIC_LEASH_API_URL=http://127.0.0.1:8000
